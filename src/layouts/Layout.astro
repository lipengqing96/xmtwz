---
interface Props { title?: string; description?: string; ogImage?: string; }
const { title = '10Best Living | Curated Luxury Product Reviews', description = 'Expert reviews and rankings of the worlds finest products for the discerning lifestyle.', ogImage = '/og-image.jpg' } = Astro.props;
---<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="lhverifycode" content="32dc01246faccb7f5b3cad5016dd5033" />
    <title>{title}</title>
    <meta name="description" content="{description}" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js" defer></script>
    <script is:inline>window.addEventListener('load', () => { if (typeof AOS !== 'undefined') AOS.init({ duration: 800, once: true, offset: 50 }); });</script>
    <meta property="og:title" content="{title}" />
    <meta property="og:description" content="{description}" />
    <meta property="og:image" content="{ogImage}" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{title}" />
    <meta name="twitter:description" content="{description}" />
    <link rel="canonical" href="{Astro.site || ''}{Astro.url.pathname}" />
    <style is:raw>
      .reading-progress{position:fixed;top:0;left:0;width:0%;height:3px;background:linear-gradient(90deg,#C9A962,#E8D5B0);z-index:9999;transition:width 0.1s linear}
      .cookie-banner{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#1A1A1A;color:#fff;padding:1rem 1.5rem;border-radius:1rem;box-shadow:0 8px 30px rgba(0,0,0,0.3);z-index:9998;display:none;align-items:center;gap:1rem;max-width:90vw;flex-wrap:wrap;justify-content:center}
      .cookie-banner button{padding:0.5rem 1.25rem;background:linear-gradient(135deg,#C9A962,#E8D5B0);color:#1A1A1A;border:none;border-radius:0.5rem;font-weight:600;cursor:pointer}
      #backToTop{position:fixed;bottom:80px;right:24px;width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,#C9A962,#E8D5B0);color:#1A1A1A;border:none;cursor:pointer;box-shadow:0 4px 20px rgba(0,0,0,0.2);z-index:9997;font-size:20px;display:none;align-items:center;justify-content:center}
      @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
      .float-anim{animation:float 3s ease-in-out infinite}
      @keyframes scroll-arrow{0%,100%{transform:translateY(0);opacity:1}50%{transform:translateY(6px);opacity:0.5}}
      .scroll-arrow{animation:scroll-arrow 1.5s ease-in-out infinite}
    </style>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-white">
    <div class="reading-progress" id="readingProgress"></div>
    <slot name="header" />
    <main><slot /></main>
    <slot name="footer" />
    <div class="cookie-banner" id="cookieBanner">
      <span>We use cookies to enhance your experience. By continuing, you agree to our cookie policy.</span>
      <button onclick="document.getElementById('cookieBanner').style.display='none';localStorage.setItem('cookiesAccepted','true')">Accept</button>
    </div>
    <button id="backToTop" onclick="window.scrollTo({top:0,behavior:'smooth'})">&#8593;</button>
    <script>
      window.addEventListener('scroll', () => {
        const p=document.getElementById('readingProgress');
        if(p){const h=document.documentElement.scrollHeight-document.documentElement.clientHeight;p.style.width=((window.scrollY||document.documentElement.scrollTop)/h*100)+'%';}
        const b=document.getElementById('backToTop');
        if(b)b.style.display=window.scrollY>400?'flex':'none';
      });
      if(localStorage.getItem('cookiesAccepted')!=='true')setTimeout(()=>{document.getElementById('cookieBanner').style.display='flex';},2000);
    </script>
  </body>
</html>