---
interface Props {
  category: string;
  emoji?: string;
  gradient?: string;
  image?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
}

const { category, emoji = '🛍️', gradient = 'from-amber-50 via-orange-50 to-yellow-50', image, size = 'md' } = Astro.props;

const sizes = {
  sm: 'aspect-[4/3] text-4xl',
  md: 'aspect-[4/3] text-6xl',
  lg: 'aspect-[16/10] text-7xl',
  xl: 'aspect-[16/9] text-8xl',
};
---

<div class={`relative overflow-hidden rounded-2xl ${sizes[size]} group`} aria-label={category}>
  {image ? (
    <img
      src={`/images/${image}`}
      alt={category}
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
  ) : (
    <div class={`absolute inset-0 bg-gradient-to-br ${gradient} flex items-center justify-center`}>
      <span class="transition-transform duration-500 group-hover:scale-110">{emoji}</span>
    </div>
  )}
  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300 rounded-2xl"></div>
</div>
