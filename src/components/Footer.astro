---
import Layout from '../layouts/Layout.astro';
---<Layout>
  <div slot="footer">
    <footer class="bg-dark text-white pt-20 pb-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
          <div>
            <div class="mb-4">
              <span class="font-playfair text-2xl font-bold"><span class="gold-text">10</span><span class="text-white">Best</span></span>
              <span class="block text-xs text-muted tracking-widest uppercase font-inter">Living</span>
            </div>
            <p class="text-muted text-sm leading-relaxed">Curated reviews of the world finest products for the discerning lifestyle. Expert insights, honest opinions, timeless recommendations.</p>
            <div class="flex gap-4 mt-6">
              <a href="#" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-gold hover:text-dark transition-all" aria-label="Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
              </a>
              <a href="#" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-gold hover:text-dark transition-all" aria-label="Twitter">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/></svg>
              </a>
              <a href="#" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-gold hover:text-dark transition-all" aria-label="Instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor"/></svg>
              </a>
              <a href="#" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-gold hover:text-dark transition-all" aria-label="Pinterest">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.92-7.262 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
              </a>
            </div>
          </div>
          <div>
            <h4 class="font-playfair text-lg font-semibold mb-6 text-gold-light">Quick Links</h4>
            <ul class="space-y-3">
              <li><a href="/" class="text-muted hover:text-gold transition-colors text-sm">Home</a></li>
              <li><a href="/blog" class="text-muted hover:text-gold transition-colors text-sm">All Reviews</a></li>
              <li><a href="/about" class="text-muted hover:text-gold transition-colors text-sm">About Us</a></li>
              <li><a href="/contact" class="text-muted hover:text-gold transition-colors text-sm">Contact</a></li>
              <li><a href="/affiliate-disclosure" class="text-muted hover:text-gold transition-colors text-sm">Affiliate Disclosure</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-playfair text-lg font-semibold mb-6 text-gold-light">Categories</h4>
            <ul class="space-y-3">
              <li><a href="/blog" class="text-muted hover:text-gold transition-colors text-sm">Home &amp; Kitchen</a></li>
              <li><a href="/blog" class="text-muted hover:text-gold transition-colors text-sm">Fitness &amp; Health</a></li>
              <li><a href="/blog" class="text-muted hover:text-gold transition-colors text-sm">Beauty &amp; Personal Care</a></li>
              <li><a href="/blog" class="text-muted hover:text-gold transition-colors text-sm">Smart Home</a></li>
              <li><a href="/blog" class="text-muted hover:text-gold transition-colors text-sm">Outdoor &amp; Travel</a></li>
            </ul>
          </div>
          <div>
            <h4 class="font-playfair text-lg font-semibold mb-6 text-gold-light">Legal</h4>
            <ul class="space-y-3">
              <li><a href="/privacy" class="text-muted hover:text-gold transition-colors text-sm">Privacy Policy</a></li>
              <li><a href="/terms-of-service" class="text-muted hover:text-gold transition-colors text-sm">Terms of Service</a></li>
              <li><a href="/affiliate-disclosure" class="text-muted hover:text-gold transition-colors text-sm">Affiliate Disclosure</a></li>
              <li><a href="/contact" class="text-muted hover:text-gold transition-colors text-sm">Contact Us</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-white/10 pt-8">
          <p class="text-muted text-xs text-center mb-4">As an Amazon Associate we earn from qualifying purchases. All recommendations are independent and impartial.</p>
          <p class="text-muted text-xs text-center">&copy; 2026 10Best Living. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </div>
</Layout>