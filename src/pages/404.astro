---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<BaseLayout title="404 - 10Best Living">
  <fragment slot="header"><Header /></fragment>
  <fragment slot="footer"><Footer /></fragment>
  <section class="min-h-screen flex items-center justify-center bg-cream pt-20">
    <div class="text-center px-6">
      <div class="text-8xl mb-6">🌟</div>
      <h1 class="font-serif text-6xl font-bold text-dark mb-4">404</h1>
      <p class="text-text-muted text-xl mb-8">This page drifted away. Let us bring you back home.</p>
      <a href="/" class="btn-primary">Return Home</a>
    </div>
  </section>
</BaseLayout>
