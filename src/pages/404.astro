---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title='404 - NebulaRank'>
  <fragment slot='header'><Header /></fragment>
  <fragment slot='footer'><Footer /></fragment>
  <section class='min-h-screen flex items-center justify-center pt-16'>
    <div class='text-center px-6'>
      <div class='text-8xl mb-6'>🌌</div>
      <h1 class='font-sans text-6xl font-bold text-white mb-4'>404</h1>
      <p class='text-gray-500 text-xl mb-8'>This page drifted into deep space.</p>
      <a href='/' class='btn-nebula'>Return Home</a>
    </div>
  </section>
</BaseLayout>

