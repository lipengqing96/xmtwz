---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = [
  { slug: 'home-kitchen', name: 'Home & Kitchen', emoji: '🏠', count: 4, color: 'from-amber-50 to-stone-100', accent: 'text-amber-700' },
  { slug: 'fitness-health', name: 'Fitness & Health', emoji: '💪', count: 3, color: 'from-emerald-50 to-teal-50', accent: 'text-emerald-700' },
  { slug: 'smart-home', name: 'Smart Home', emoji: '🏡', count: 2, color: 'from-blue-50 to-indigo-50', accent: 'text-blue-700' },
  { slug: 'beauty', name: 'Beauty & Personal Care', emoji: '✨', count: 2, color: 'from-rose-50 to-pink-50', accent: 'text-rose-600' },
  { slug: 'outdoor-travel', name: 'Outdoor & Travel', emoji: '🏔️', count: 1, color: 'from-orange-50 to-amber-50', accent: 'text-orange-700' },
  { slug: 'bedroom', name: 'Bedroom', emoji: '🛏️', count: 1, color: 'from-purple-50 to-violet-50', accent: 'text-purple-700' },
  { slug: 'home-office', name: 'Home & Office', emoji: '💻', count: 1, color: 'from-slate-50 to-gray-100', accent: 'text-slate-700' },
  { slug: 'home-decor', name: 'Home & Decor', emoji: '🎨', count: 1, color: 'from-yellow-50 to-amber-50', accent: 'text-yellow-700' },
];

const recentReviews = [
  { slug: 'top-10-best-portable-blenders-smoothies-2026', title: 'Top 10 Best Portable Blenders', cat: 'Home & Kitchen', emoji: '🥤' },
  { slug: 'top-10-best-robot-vacuums-under-300', title: 'Top 10 Best Robot Vacuums', cat: 'Smart Home', emoji: '🤖' },
  { slug: 'top-10-best-coffee-makers-single-serve', title: 'Top 10 Best Coffee Makers', cat: 'Home & Kitchen', emoji: '☕' },
];
---

<BaseLayout title="Categories — 10Best Living" description="Browse product reviews by category. Find the best rated products for every part of your life.">
  <div class="bg-card">
    <div class="py-20 lg:py-28 bg-gradient-to-br from-cream via-cream-dark to-cream">
      <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center" data-aos="fade-up">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gold/30 bg-gold/5 mb-6">
          <span class="w-2 h-2 rounded-full bg-gold"></span>
          <span class="text-xs font-sans font-medium tracking-[0.2em] uppercase text-gold">Browse Reviews</span>
        </div>
        <h1 class="font-serif text-5xl lg:text-6xl font-bold text-primary mb-6 leading-tight">
          Browse by <span class="gold-gradient-text">Category</span>
        </h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto leading-relaxed">
          Explore our curated reviews organized by category. From kitchen essentials to smart home tech, find exactly what you need.
        </p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {categories.map((cat, i) => (
          <a
            href={`/blog#${cat.slug}`}
            class="group relative overflow-hidden rounded-2xl aspect-[4/3] cursor-pointer"
            data-aos="fade-up"
            data-aos-delay={i * 50}
          >
            <div class={`absolute inset-0 bg-gradient-to-br ${cat.color} group-hover:scale-105 transition-transform duration-500`}></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center p-6">
              <span class="text-5xl mb-3 group-hover:scale-110 transition-transform duration-300">{cat.emoji}</span>
              <h3 class="font-serif text-lg font-bold text-primary text-center mb-1">{cat.name}</h3>
              <span class={`text-xs font-medium ${cat.accent}`}>{cat.count} Review{cat.count > 1 ? 's' : ''}</span>
            </div>
            <div class="absolute inset-0 border-2 border-transparent group-hover:border-gold/40 rounded-2xl transition-colors duration-300"></div>
          </a>
        ))}
      </div>

      <!-- Recent Reviews -->
      <div class="mt-20" data-aos="fade-up">
        <h2 class="font-serif text-3xl font-bold text-primary mb-8 text-center">Recently Published</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {recentReviews.map((review, i) => (
            <a href={`/blog/${review.slug}`} class="bg-cream rounded-2xl overflow-hidden hover:shadow-elevated transition-all duration-300 group" key={i}>
              <div class="relative aspect-[16/10] overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-amber-50 to-stone-100 group-hover:scale-105 transition-transform duration-500"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                  <span class="text-6xl group-hover:scale-110 transition-transform duration-300">{review.emoji}</span>
                </div>
              </div>
              <div class="p-5">
                <span class="text-xs font-medium text-gold mb-2 block">{review.cat}</span>
                <h3 class="font-serif text-base font-bold text-primary group-hover:text-gold transition-colors line-clamp-2">{review.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>



