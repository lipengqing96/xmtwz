---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout title="Categories | 10Best Living">
  <fragment slot="header"><Header /></fragment>
  <fragment slot="footer"><Footer /></fragment>
  <section class="py-24 bg-cream">
    <div class="max-w-7xl mx-auto px-6">
      <h1 class="font-serif text-5xl font-bold text-dark mb-4">Categories</h1>
      <div class="section-divider w-24 mb-8"></div>
      <p class="text-text-muted text-lg max-w-2xl mb-16">Explore reviews by topic. Every category is curated with care.</p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
        {[
          {name:'Home & Kitchen',slug:'home-kitchen',emoji:'🏠',count:48},
          {name:'Fitness & Health',slug:'fitness-health',emoji:'💪',count:36},
          {name:'Beauty & Care',slug:'beauty-care',emoji:'✨',count:42},
          {name:'Smart Home',slug:'smart-home',emoji:'🏡',count:31},
          {name:'Outdoor & Travel',slug:'outdoor-travel',emoji:'✈️',count:28},
          {name:'Office',slug:'office',emoji:'🪑',count:24},
          {name:'Gaming',slug:'gaming',emoji:'🎮',count:19},
          {name:'Pet',slug:'pet',emoji:'🐾',count:15},
          {name:'Baby & Kids',slug:'baby-kids',emoji:'👶',count:12},
          {name:'Garden',slug:'garden',emoji:'🌱',count:10},
        ].map((cat)=>(
          <a href={`/blog?category=${cat.slug}`} class="card-hover bg-white rounded-2xl p-6 text-center group cursor-pointer">
            <div class="text-4xl mb-3 group-hover:scale-110 transition-transform">{cat.emoji}</div>
            <div class="font-serif text-dark font-semibold">{cat.name}</div>
            <div class="text-muted text-sm mt-1">{cat.count} reviews</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
