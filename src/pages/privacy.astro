---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Privacy Policy - NebulaRank">
  <fragment slot="header"><Header /></fragment>
  <fragment slot="footer"><Footer /></fragment>
  <section class="pt-32 pb-20 relative">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="font-sans text-4xl font-bold text-white mb-8">Privacy Policy</h1>
      <div class="prose prose-invert text-gray-400 leading-relaxed">
        <p class="mb-4"><strong class="text-white">Last updated:</strong> January 2026</p>
        <h2 class="text-white text-xl font-semibold mt-8 mb-4">1. Information We Collect</h2>
        <p class="mb-4">We collect information you provide directly (email for newsletter, contact form submissions) and automatically (browser type, IP address, pages visited).</p>
        <h2 class="text-white text-xl font-semibold mt-8 mb-4">2. How We Use Information</h2>
        <p class="mb-4">To deliver content, improve our site, send newsletters (with your consent), and analyze usage patterns.</p>
        <h2 class="text-white text-xl font-semibold mt-8 mb-4">3. Cookies</h2>
        <p class="mb-4">We use cookies for analytics and to remember your preferences. You can control cookie settings in your browser.</p>
        <h2 class="text-white text-xl font-semibold mt-8 mb-4">4. Third-Party Services</h2>
        <p class="mb-4">We use Google Analytics for traffic analysis. Affiliate links may use tracking cookies from partners like Amazon.</p>
        <h2 class="text-white text-xl font-semibold mt-8 mb-4">5. Data Security</h2>
        <p class="mb-4">We implement industry-standard security measures to protect your data.</p>
        <h2 class="text-white text-xl font-semibold mt-8 mb-4">6. Your Rights</h2>
        <p class="mb-4">You can request access to, correction of, or deletion of your personal data at any time.</p>
        <h2 class="text-white text-xl font-semibold mt-8 mb-4">7. Contact</h2>
        <p class="mb-4">Questions about privacy? Email us at privacy@nebularank.com</p>
      </div>
    </div>
  </section>
</BaseLayout>
