---
layout: "../../layouts/BaseLayout.astro"
title: "Review | 10Best Living"

export async function getStaticPaths() {
  return [
    { params: { slug: "top-10-best-portable-blenders-smoothies-2026" } },
    { params: { slug: "top-10-best-led-desk-lamps-work-from-home" } },
    { params: { slug: "top-10-best-yoga-mats-beginners" } },
    { params: { slug: "top-10-best-robot-vacuums-under-300" } },
    { params: { slug: "top-10-best-essential-oil-diffusers" } },
    { params: { slug: "top-10-best-air-fryers-small-kitchen" } },
    { params: { slug: "top-10-best-weighted-blankets-better-sleep" } },
    { params: { slug: "top-10-best-electric-kettles-precise-temperature" } },
    { params: { slug: "top-10-best-standing-desks-converter" } },
    { params: { slug: "top-10-best-cordless-vacuums-lightweight" } },
    { params: { slug: "top-10-best-skincare-fridges-mini" } },
    { params: { slug: "top-10-best-insulated-water-bottles" } },
    { params: { slug: "top-10-best-massage-guns-recovery" } },
    { params: { slug: "top-10-best-coffee-makers-single-serve" } },
    { params: { slug: "top-10-best-area-rugs-living-room" } },
  ];
}

const { slug } = Astro.params;

// Load posts from individual JSON files
const posts = {};
const postFiles = import.meta.glob("../../data/posts/*.json", { eager: true });
for (const [path, module] of Object.entries(postFiles)) {
  const filename = path.split("/").pop();
  const postSlug = filename.replace(".json", "");
  posts[postSlug] = module.default;
}

const post = posts[slug];
if (!post) Astro.redirect("/404");
---

<article class="pt-28 pb-20 relative">
  <div class="max-w-3xl mx-auto px-6">
    <img src="{post.featuredImg}" alt="{post.title}" class="w-full h-64 md:h-80 object-cover rounded-2xl mb-8 shadow-card" loading="eager"/>
    <div class="flex items-center gap-3 mb-6">
      <span class="px-3 py-1 rounded-full text-sm font-medium bg-gold/20 text-gold">{post.category}</span>
      <span class="text-gray-600">{post.readTime} read · {post.date}</span>
    </div>
    <h1 class="font-serif text-4xl md:text-5xl font-bold text-dark mb-6 leading-tight">{post.title}</h1>
    <div class="w-16 h-1 bg-gradient-to-r from-gold to-gold-light rounded-full mb-8"></div>
    <div class="prose prose-lg max-w-none text-text-muted leading-relaxed whitespace-pre-line">{post.content}</div>
  </div>
</article>
