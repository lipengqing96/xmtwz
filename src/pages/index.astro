---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="NebulaRank - Next-Gen Product Reviews">
  <fragment slot="header"><Header /></fragment>
  <fragment slot="footer"><Footer /></fragment>

  <!-- Hero -->
  <section class="relative min-h-screen flex items-center pt-16 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-indigo-950/30 via-deep to-deep"></div>
    <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-indigo-600/20 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="relative max-w-7xl mx-auto px-6 py-32 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 text-indigo-400 text-sm font-medium mb-8">
          <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
          Data-Driven Reviews Since 2026
        </div>
        <h1 class="font-sans text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-tight tracking-tight mb-6">
          Test.<br/><span class="gradient-text">Trust.</span><br/>Rank.
        </h1>
        <p class="text-gray-400 text-lg leading-relaxed mb-10 max-w-lg">
          We rigorously test every product so you don't waste money on hype. Unbiased rankings, real data, honest verdicts.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/blog" class="btn-nebula">Read Reviews</a>
          <a href="/categories" class="btn-outline-nebula">Browse Topics</a>
        </div>
      </div>
      <div class="relative hidden lg:block">
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4 mt-8">
            <a href="/blog?category=tech" class="card-deep p-4 group block hover:border-indigo-500/40 transition-colors">
              <div class="h-32 rounded-xl bg-gradient-to-br from-indigo-600/30 to-violet-600/30 mb-3 flex items-center justify-center text-4xl">🖥️</div>
              <div class="text-white font-semibold group-hover:text-indigo-400 transition-colors">Tech</div>
              <div class="text-gray-500 text-sm">48 Reviews</div>
            </a>
            <a href="/blog?category=lifestyle" class="card-deep p-4 group block hover:border-indigo-500/40 transition-colors">
              <div class="h-24 rounded-xl bg-gradient-to-br from-cyan-600/30 to-indigo-600/30 mb-3 flex items-center justify-center text-4xl">🏠</div>
              <div class="text-white font-semibold group-hover:text-indigo-400 transition-colors">Lifestyle</div>
              <div class="text-gray-500 text-sm">36 Reviews</div>
            </a>
          </div>
          <div class="space-y-4">
            <a href="/blog?category=fitness" class="card-deep p-4 group block hover:border-indigo-500/40 transition-colors">
              <div class="h-24 rounded-xl bg-gradient-to-br from-violet-600/30 to-pink-600/30 mb-3 flex items-center justify-center text-4xl">💪</div>
              <div class="text-white font-semibold group-hover:text-indigo-400 transition-colors">Fitness</div>
              <div class="text-gray-500 text-sm">24 Reviews</div>
            </a>
            <a href="/blog?category=audio" class="card-deep p-4 group block hover:border-indigo-500/40 transition-colors">
              <div class="h-32 rounded-xl bg-gradient-to-br from-indigo-600/30 to-cyan-600/30 mb-3 flex items-center justify-center text-4xl">🎧</div>
              <div class="text-white font-semibold group-hover:text-indigo-400 transition-colors">Audio</div>
              <div class="text-gray-500 text-sm">31 Reviews</div>
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 text-gray-600">
      <div class="flex items-center gap-8 text-sm">
        <span class="flex items-center gap-2"><span class="text-indigo-400 font-bold text-lg">500+</span> Products Tested</span>
        <span class="flex items-center gap-2"><span class="text-indigo-400 font-bold text-lg">1.2k+</span> Expert Reviews</span>
        <span class="flex items-center gap-2"><span class="text-indigo-400 font-bold text-lg">15</span> Categories</span>
      </div>
      <div class="animate-bounce"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
    </div>
  </section>

  <!-- Featured Reviews -->
  <section class="py-24 relative">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex items-center justify-between mb-12">
        <div>
          <h2 class="font-sans text-3xl md:text-4xl font-bold text-white mb-2">Featured Reviews</h2>
          <div class="w-16 h-0.5 bg-gradient-to-r from-indigo-500 to-transparent"></div>
        </div>
        <a href="/blog" class="btn-outline-nebula text-sm px-4 py-2">View All</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/blog/top-10-best-noise-cancelling-headphones" class="card-deep group hover:border-indigo-500/40 transition-all duration-300 hover:glow-indigo">
          <div class="h-48 bg-gradient-to-br from-indigo-900/50 to-violet-900/50 flex items-center justify-center text-6xl group-hover:scale-105 transition-transform duration-500">🎧</div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3"><span class="px-2 py-0.5 rounded-full text-xs font-medium bg-indigo-500/20 text-indigo-400">Audio</span><span class="text-gray-600 text-xs">· 12 min read</span></div>
            <h3 class="text-white font-bold text-lg mb-2 group-hover:text-indigo-400 transition-colors">Top 10 Noise-Cancelling Headphones of 2026</h3>
            <p class="text-gray-500 text-sm leading-relaxed">Silence is golden. We tested 30+ headphones to find the ones that truly block out the world.</p>
            <div class="mt-4 flex items-center gap-1 text-indigo-400 text-sm font-medium"><span>Read review</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></div>
          </div>
        </a>
        <a href="/blog/top-10-best-mechanical-keyboards" class="card-deep group hover:border-indigo-500/40 transition-all duration-300 hover:glow-indigo">
          <div class="h-48 bg-gradient-to-br from-cyan-900/50 to-indigo-900/50 flex items-center justify-center text-6xl group-hover:scale-105 transition-transform duration-500">⌨️</div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3"><span class="px-2 py-0.5 rounded-full text-xs font-medium bg-cyan-500/20 text-cyan-400">Tech</span><span class="text-gray-600 text-xs">· 10 min read</span></div>
            <h3 class="text-white font-bold text-lg mb-2 group-hover:text-indigo-400 transition-colors">Top 10 Best Mechanical Keyboards</h3>
            <p class="text-gray-500 text-sm leading-relaxed">From thocky boardwalks to clicky clack - the definitive guide to mechanical keyboards.</p>
            <div class="mt-4 flex items-center gap-1 text-indigo-400 text-sm font-medium"><span>Read review</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></div>
          </div>
        </a>
        <a href="/blog/top-10-best-smart-watches-2026" class="card-deep group hover:border-indigo-500/40 transition-all duration-300 hover:glow-indigo">
          <div class="h-48 bg-gradient-to-br from-violet-900/50 to-pink-900/50 flex items-center justify-center text-6xl group-hover:scale-105 transition-transform duration-500">⌚</div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3"><span class="px-2 py-0.5 rounded-full text-xs font-medium bg-violet-500/20 text-violet-400">Wearables</span><span class="text-gray-600 text-xs">· 14 min read</span></div>
            <h3 class="text-white font-bold text-lg mb-2 group-hover:text-indigo-400 transition-colors">Top 10 Best Smart Watches 2026</h3>
            <p class="text-gray-500 text-sm leading-relaxed">Your wrist is your command center. Here are the watches worth your attention this year.</p>
            <div class="mt-4 flex items-center gap-1 text-indigo-400 text-sm font-medium"><span>Read review</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg></div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-24 bg-deep-card/50 relative">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="font-sans text-3xl md:text-4xl font-bold text-white mb-3">Browse by Category</h2>
        <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-indigo-500 to-transparent mx-auto"></div>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {[
          { name: 'Tech', slug: 'tech', emoji: '💻', count: 48 },
          { name: 'Audio', slug: 'audio', emoji: '🎧', count: 31 },
          { name: 'Wearables', slug: 'wearables', emoji: '⌚', count: 22 },
          { name: 'Fitness', slug: 'fitness', emoji: '💪', count: 24 },
          { name: 'Home', slug: 'home', emoji: '🏠', count: 36 },
          { name: 'Kitchen', slug: 'kitchen', emoji: '🍳', count: 28 },
          { name: 'Beauty', slug: 'beauty', emoji: '✨', count: 19 },
          { name: 'Travel', slug: 'travel', emoji: '✈️', count: 15 },
          { name: 'Gaming', slug: 'gaming', emoji: '🎮', count: 33 },
          { name: 'Office', slug: 'office', emoji: '🪑', count: 21 },
        ].map((cat) => (
          <a href={`/blog?category=${cat.slug}`} class="card-deep p-5 text-center group hover:border-indigo-500/40 transition-all duration-300 hover:-translate-y-1">
            <div class="text-3xl mb-3 group-hover:scale-110 transition-transform">{cat.emoji}</div>
            <div class="text-white font-semibold text-sm">{cat.name}</div>
            <div class="text-gray-600 text-xs mt-1">{cat.count} reviews</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="py-24 relative">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <h2 class="font-sans text-3xl md:text-4xl font-bold text-white mb-4">Stay in the Loop</h2>
      <p class="text-gray-500 mb-8">Get our best reviews and deals delivered to your inbox. No spam, ever.</p>
      <form class="flex gap-3 max-w-md mx-auto" onsubmit="event.preventDefault(); alert('Thanks for subscribing!')">
        <input type="email" placeholder="you@example.com" required class="flex-1 px-4 py-3 rounded-xl bg-deep-card border border-deep-border text-white placeholder-gray-600 focus:outline-none focus:border-indigo-500 transition-colors" />
        <button type="submit" class="btn-nebula whitespace-nowrap">Subscribe</button>
      </form>
    </div>
  </section>
</BaseLayout>
