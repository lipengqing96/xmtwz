---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---<Layout title="10Best Living | Curated Luxury Product Reviews" description="Expert reviews and rankings of the world finest products for the discerning lifestyle.">
  <div slot="header"><Header /></div>
  <div slot="footer"><Footer /></div>

  <!-- Hero Section -->
  <section class="min-h-screen flex items-center relative overflow-hidden bg-cream">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-20 left-10 w-72 h-72 bg-gold rounded-full filter blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-gold-light rounded-full filter blur-3xl"></div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div data-aos="fade-right">
          <div class="badge-gold mb-6 inline-flex">
            <span class="w-2 h-2 rounded-full bg-gold"></span>
            TRUSTED REVIEWS SINCE 2026
          </div>
          <h1 class="font-playfair text-5xl md:text-6xl lg:text-7xl font-bold leading-tight mb-6">
            Discover the World'\''s Finest Products
          </h1>
          <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-8 max-w-lg">
            Curated reviews and expert insights, handpicked classics for a lifestyle of exceptional taste.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/blog" class="btn-primary">Explore Reviews</a>
            <a href="/about" class="btn-outline">Our Story</a>
          </div>
          <div class="flex flex-wrap gap-8 mt-12 pt-8 border-t border-border">
            <div>
              <p class="font-playfair text-3xl font-bold gold-text">500+</p>
              <p class="text-sm text-muted">Products Tested</p>
            </div>
            <div>
              <p class="font-playfair text-3xl font-bold gold-text">50K+</p>
              <p class="text-sm text-muted">Readers Monthly</p>
            </div>
            <div>
              <p class="font-playfair text-3xl font-bold gold-text">15</p>
              <p class="text-sm text-muted">Expert Reviewers</p>
            </div>
          </div>
        </div>
        <div class="hidden lg:block" data-aos="fade-left">
          <div class="grid grid-cols-2 gap-4">
            <div class="card p-4 float-anim" style="animation-delay:0s">
              <div class="aspect-square bg-gradient-to-br from-cream to-gold/20 rounded-lg flex items-center justify-center mb-3">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#C9A962" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
              </div>
              <p class="font-playfair font-semibold text-center">Premium Picks</p>
            </div>
            <div class="card p-4 float-anim mt-8" style="animation-delay:0.5s">
              <div class="aspect-square bg-gradient-to-br from-emerald-dark/10 to-cream rounded-lg flex items-center justify-center mb-3">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#2D5A4C" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              </div>
              <p class="font-playfair font-semibold text-center">Expert Rated</p>
            </div>
            <div class="card p-4 float-anim" style="animation-delay:1s">
              <div class="aspect-square bg-gradient-to-br from-gold/20 to-cream rounded-lg flex items-center justify-center mb-3">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#C9A962" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              </div>
              <p class="font-playfair font-semibold text-center">Timeless Quality</p>
            </div>
            <div class="card p-4 float-anim mt-8" style="animation-delay:1.5s">
              <div class="aspect-square bg-gradient-to-br from-cream to-emerald-dark/10 rounded-lg flex items-center justify-center mb-3">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#2D5A4C" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
              </div>
              <p class="font-playfair font-semibold text-center">Handpicked</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 scroll-arrow text-gold">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="font-playfair text-4xl md:text-5xl font-bold mb-4">Browse by Category</h2>
        <div class="section-divider mx-auto"></div>
        <p class="text-text-muted max-w-2xl mx-auto">Explore our curated collections across the finest product categories</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          { name: 'Home & Kitchen', count: 42, color: 'from-amber-50 to-orange-50' },
          { name: 'Fitness & Health', count: 38, color: 'from-emerald-50 to-teal-50' },
          { name: 'Beauty & Personal Care', count: 35, color: 'from-rose-50 to-pink-50' },
          { name: 'Smart Home', count: 29, color: 'from-blue-50 to-indigo-50' },
          { name: 'Outdoor & Travel', count: 31, color: 'from-sky-50 to-cyan-50' },
        ].map(cat => (
          <a href="/blog" class="card group" data-aos="fade-up">
            <div class={['aspect-[4/3]', 'bg-gradient-to-br', cat.color, 'flex items-center justify-center'].join(' ')}>
              <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#C9A962" stroke-width="1.5" class="group-hover:scale-110 transition-transform duration-300">
                <circle cx="12" cy="12" r="10"/>
              </svg>
            </div>
            <div class="p-6">
              <div class="flex items-center justify-between mb-2">
                <h3 class="font-playfair text-xl font-semibold group-hover:text-gold transition-colors">{cat.name}</h3>
                <span class="badge-gold">{cat.count} reviews</span>
              </div>
              <p class="text-sm text-muted">Top products for every occasion</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Reviews -->
  <section class="py-24 bg-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16" data-aos="fade-up">
        <h2 class="font-playfair text-4xl md:text-5xl font-bold mb-4">Editor'\''s Picks</h2>
        <div class="section-divider mx-auto"></div>
        <p class="text-text-muted max-w-2xl mx-auto">Our top recommendations this month, hand-tested by our expert reviewers</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          { title: 'Top 10 Best Portable Blenders for Smoothies 2026', excerpt: 'Discover the best portable blenders for on-the-go smoothies. From BlenderBottle to NutriBullet Go.', category: 'Home & Kitchen', time: '12 min read', badge: "Editor's Choice", slug: 'top-10-best-portable-blenders-smoothies-2026' },
          { title: 'Top 10 Best Robot Vacuums Under  in 2026', excerpt: 'Keep your home spotless without breaking the bank. Our comprehensive guide to budget robot vacuums.', category: 'Smart Home', time: '15 min read', badge: 'Best Value', slug: 'top-10-best-robot-vacuums-under-300' },
          { title: 'Top 10 Best Air Fryers for Small Kitchens 2026', excerpt: 'Compact, efficient, and delicious. The best air fryers for small spaces in 2026.', category: 'Home & Kitchen', time: '12 min read', badge: 'Top Pick', slug: 'top-10-best-air-fryers-small-kitchen' },
        ].map(review => (
          <a href={/blog/} class="card group" data-aos="fade-up">
            <div class="aspect-[16/10] bg-gradient-to-br from-cream to-gold/20 flex items-center justify-center relative overflow-hidden">
              <div class="absolute top-4 left-4">
                <span class="badge-gold">{review.category}</span>
              </div>
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#C9A962" stroke-width="1" class="opacity-30">
                <rect x="2" y="3" width="20" height="14" rx="2"/>
                <line x1="8" y1="21" x2="16" y2="21"/>
                <line x1="12" y1="17" x2="12" y2="21"/>
              </svg>
            </div>
            <div class="p-6">
              <div class="flex items-center gap-2 mb-3">
                <span class="badge-emerald">{review.badge}</span>
                <span class="text-xs text-muted">{review.time}</span>
              </div>
              <h3 class="font-playfair text-lg font-semibold mb-2 group-hover:text-gold transition-colors line-clamp-2">{review.title}</h3>
              <p class="text-sm text-text-muted line-clamp-2 mb-4">{review.excerpt}</p>
              <span class="text-gold font-medium text-sm inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                Read Review
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="/blog" class="btn-outline">View All Reviews</a>
      </div>
    </div>
  </section>

  <!-- Newsletter Section -->
  <section class="py-24 bg-gradient-to-br from-[#C9A962] via-[#E8D5B0] to-[#A68B4B]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center" data-aos="fade-up">
      <h2 class="font-playfair text-4xl md:text-5xl font-bold text-dark mb-4">Join 50,000+ Discerning Shoppers</h2>
      <p class="text-dark/70 text-lg mb-8">Get our weekly curated picks and exclusive deals delivered to your inbox.</p>
      <form class="flex flex-col sm:flex-row gap-4 max-w-lg mx-auto" onsubmit="event.preventDefault(); alert('Thanks for subscribing!');">
        <input type="email" placeholder="Enter your email" class="flex-1 px-6 py-4 rounded-lg border-2 border-dark/20 focus:border-dark outline-none bg-white/80 backdrop-blur text-dark placeholder-dark/40" required />
        <button type="submit" class="btn-primary bg-dark text-gold-light hover:bg-dark/90 border-none">Subscribe</button>
      </form>
      <p class="text-dark/50 text-xs mt-4">No spam, ever. Unsubscribe anytime.</p>
    </div>
  </section>

</Layout>