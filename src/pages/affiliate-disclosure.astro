---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Affiliate Disclosure - NebulaRank">
  <fragment slot="header"><Header /></fragment>
  <fragment slot="footer"><Footer /></fragment>
  <section class="pt-32 pb-20 relative">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="font-sans text-4xl font-bold text-white mb-8">Affiliate Disclosure</h1>
      <div class="prose prose-invert text-gray-400 leading-relaxed">
        <p class="mb-4"><strong class="text-white">FTC Compliance Statement</strong></p>
        <p class="mb-4">NebulaRank is a participant in various affiliate advertising programs. This means we may earn a commission when you click on or make purchases through our links, at no additional cost to you.</p>
        <h2 class="text-white text-xl font-semibold mt-8 mb-4">Our Commitment to Honesty</h2>
        <p class="mb-4">Affiliate relationships do not influence our product testing, ratings, or recommendations. We purchase products ourselves whenever possible and maintain strict editorial independence.</p>
        <h2 class="text-white text-xl font-semibold mt-8 mb-4">How It Works</h2>
        <p class="mb-4">When you click an affiliate link and make a purchase, the retailer pays us a small percentage. This helps fund our testing lab and allows us to continue providing free, unbiased reviews.</p>
        <h2 class="text-white text-xl font-semibold mt-8 mb-4">Our Partners</h2>
        <p class="mb-4">We participate in Amazon Services LLC Associates Program, as well as other affiliate programs. All partnerships are disclosed transparently.</p>
      </div>
    </div>
  </section>
</BaseLayout>
