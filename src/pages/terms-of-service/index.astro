---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title={`Terms of Service | 10Best Living`} description={`10Best Living terms of service. Learn about your rights and responsibilities when using our website.`} path={`/terms-of-service`}>
  <div class="bg-card">
    <div class="py-20 lg:py-28 bg-gradient-to-br from-cream via-cream-dark to-cream">
      <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center" data-aos="fade-up">
        <h1 class="font-serif text-4xl lg:text-5xl font-bold text-primary mb-6 leading-tight">Terms of Service</h1>
      </div>
    </div>
    <div class="max-w-4xl mx-auto px-6 lg:px-8 py-16">
      <div class="prose-content text-lg leading-relaxed text-primary" data-aos="fade-up">
<h2 id="sec-1">Acceptance of Terms</h2>
<p>By accessing and using 10bestliving.com, you accept and agree to be bound by these Terms of Service. If you do not agree, please do not use our website.</p>

<h2 id="sec-2">Content</h2>
