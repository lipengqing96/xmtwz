---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---<Layout title="About Us | 10Best Living" description="Learn about our team of expert reviewers and our mission to help you make informed purchasing decisions.">
  <div slot="header"><Header /></div>
  <div slot="footer"><Footer /></div>
  <section class="pt-32 pb-20 bg-cream">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-playfair text-5xl font-bold mb-6">About 10Best Living</h1>
      <div class="section-divider"></div>
      <p class="text-lg text-text-muted leading-relaxed mb-8">Founded in 2026, 10Best Living is dedicated to helping discerning consumers find the finest products in every category. Our team of expert reviewers tests and evaluates hundreds of products annually to bring you honest, thorough, and unbiased recommendations.</p>
      <h2 class="font-playfair text-2xl font-semibold mt-12 mb-4">Our Mission</h2>
      <p class="text-text-muted leading-relaxed mb-8">We believe that everyone deserves access to honest, expert product reviews. Our mission is to cut through the marketing noise and help you find products that truly deliver on their promises — products worthy of your home, your lifestyle, and your investment.</p>
      <h2 class="font-playfair text-2xl font-semibold mt-12 mb-4">Our Process</h2>
      <ul class="space-y-3 text-text-muted mb-8">
        <li class="flex items-start gap-3"><span class="text-gold font-bold">1.</span> Extensive product research and selection</li>
        <li class="flex items-start gap-3"><span class="text-gold font-bold">2.</span> Hands-on testing by our expert reviewers</li>
        <li class="flex items-start gap-3"><span class="text-gold font-bold">3.</span> Comparison against competitors in the same price range</li>
        <li class="flex items-start gap-3"><span class="text-gold font-bold">4.</span> Honest assessment of pros and cons</li>
        <li class="flex items-start gap-3"><span class="text-gold font-bold">5.</span> Clear, actionable recommendations</li>
      </ul>
      <h2 class="font-playfair text-2xl font-semibold mt-12 mb-4">Our Values</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="card p-6">
          <h3 class="font-playfair text-lg font-semibold mb-2">Honesty</h3>
          <p class="text-sm text-text-muted">Every review is unbiased and independent. We never accept payment for positive coverage.</p>
        </div>
        <div class="card p-6">
          <h3 class="font-playfair text-lg font-semibold mb-2">Expertise</h3>
          <p class="text-sm text-text-muted">Our reviewers bring years of experience and deep product knowledge to every evaluation.</p>
        </div>
        <div class="card p-6">
          <h3 class="font-playfair text-lg font-semibold mb-2">Clarity</h3>
          <p class="text-sm text-text-muted">We present information clearly so you can make confident purchasing decisions.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>