---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---<Layout title="Contact Us | 10Best Living" description="Get in touch with our team. We love hearing from our readers.">
  <div slot="header"><Header /></div>
  <div slot="footer"><Footer /></div>
  <section class="pt-32 pb-20 bg-cream">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="font-playfair text-5xl font-bold mb-6">Contact Us</h1>
      <div class="section-divider"></div>
      <p class="text-lg text-text-muted mb-12">Have a question, suggestion, or want to work with us? We would love to hear from you.</p>
      <div class="grid md:grid-cols-2 gap-12">
        <div>
          <h2 class="font-playfair text-2xl font-semibold mb-6">Get in Touch</h2>
          <div class="space-y-4 text-text-muted">
            <p><strong class="text-dark">Email:</strong> hello@10bestliving.com</p>
            <p><strong class="text-dark">Business Inquiries:</strong> partnerships@10bestliving.com</p>
            <p><strong class="text-dark">Press:</strong> press@10bestliving.com</p>
          </div>
          <div class="mt-8 p-6 card">
            <h3 class="font-playfair text-lg font-semibold mb-2">Response Time</h3>
            <p class="text-sm text-text-muted">We typically respond within 24-48 business hours. For urgent matters, please indicate so in your email subject line.</p>
          </div>
        </div>
        <div>
          <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you for your message! We will get back to you soon.');">
            <div>
              <label class="block text-sm font-medium mb-2">Name</label>
              <input type="text" class="w-full px-4 py-3 rounded-lg border border-border focus:border-gold outline-none transition-colors" placeholder="Your name" required />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2">Email</label>
              <input type="email" class="w-full px-4 py-3 rounded-lg border border-border focus:border-gold outline-none transition-colors" placeholder="your@email.com" required />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2">Subject</label>
              <input type="text" class="w-full px-4 py-3 rounded-lg border border-border focus:border-gold outline-none transition-colors" placeholder="What is this about?" required />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2">Message</label>
              <textarea class="w-full px-4 py-3 rounded-lg border border-border focus:border-gold outline-none transition-colors min-h-[120px]" placeholder="Tell us more..." required></textarea>
            </div>
            <button type="submit" class="btn-primary w-full">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>