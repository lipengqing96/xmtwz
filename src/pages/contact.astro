---
layout: '../layouts/BaseLayout.astro'
title: "Contact | 10Best Living"
---

  
  <section class="py-24 bg-cream">
    <div class="max-w-2xl mx-auto px-6">
      <h1 class="font-serif text-5xl font-bold text-dark mb-4">Contact Us</h1>
      <div class="section-divider w-24 mb-8"></div>
      <p class="text-text-muted text-lg mb-12">Have a question, suggestion, or product to review? We'd love to hear from you.</p>
      <form class="space-y-6" onsubmit="event.preventDefault();alert('Message sent! We will get back to you soon.');">
        <div class="grid grid-cols-2 gap-6">
          <div><label class="block text-sm font-medium text-dark mb-2">Name</label><input type="text" required class="w-full px-4 py-3 rounded-xl border border-border text-dark placeholder-gray-400 focus:outline-none focus:border-gold transition-colors" placeholder="Your name"/></div>
          <div><label class="block text-sm font-medium text-dark mb-2">Email</label><input type="email" required class="w-full px-4 py-3 rounded-xl border border-border text-dark placeholder-gray-400 focus:outline-none focus:border-gold transition-colors" placeholder="you@example.com"/></div>
        </div>
        <div><label class="block text-sm font-medium text-dark mb-2">Subject</label><select class="w-full px-4 py-3 rounded-xl border border-border text-dark focus:outline-none focus:border-gold transition-colors"><option>General Inquiry</option><option>Product Review Request</option><option>Partnership</option></select></div>
        <div><label class="block text-sm font-medium text-dark mb-2">Message</label><textarea rows="6" required class="w-full px-4 py-3 rounded-xl border border-border text-dark placeholder-gray-400 focus:outline-none focus:border-gold transition-colors resize-none" placeholder="Tell us what's on your mind..."></textarea></div>
        <button type="submit" class="btn-primary w-full justify-center">Send Message</button>
      </form>
      <div class="mt-12 pt-8 border-t border-border flex flex-col md:flex-row gap-8 text-sm text-muted">
        <span class="flex items-center gap-2">✉️ hello@10bestliving.com</span>
        <span class="flex items-center gap-2">📍 San Francisco, CA</span>
      </div>
    </div>
  </section>