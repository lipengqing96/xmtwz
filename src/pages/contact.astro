---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Contact - NebulaRank">
  <fragment slot="header"><Header /></fragment>
  <fragment slot="footer"><Footer /></fragment>

  <section class="pt-32 pb-20 relative">
    <div class="max-w-2xl mx-auto px-6">
      <h1 class="font-sans text-4xl md:text-5xl font-bold text-white mb-4">Contact Us</h1>
      <p class="text-gray-500 text-lg mb-12">Have a question, suggestion, or product to review? We'd love to hear from you.</p>
      <form class="space-y-6" onsubmit="event.preventDefault(); alert('Message sent! We will get back to you soon.');">
        <div class="grid grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-medium text-gray-400 mb-2">Name</label>
            <input type="text" required class="w-full px-4 py-3 rounded-xl bg-deep-card border border-deep-border text-white placeholder-gray-600 focus:outline-none focus:border-indigo-500 transition-colors" placeholder="Your name" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-400 mb-2">Email</label>
            <input type="email" required class="w-full px-4 py-3 rounded-xl bg-deep-card border border-deep-border text-white placeholder-gray-600 focus:outline-none focus:border-indigo-500 transition-colors" placeholder="you@example.com" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-400 mb-2">Subject</label>
          <select class="w-full px-4 py-3 rounded-xl bg-deep-card border border-deep-border text-gray-400 focus:outline-none focus:border-indigo-500 transition-colors">
            <option>General Inquiry</option>
            <option>Product Review Request</option>
            <option>Partnership</option>
            <option>Technical Issue</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-400 mb-2">Message</label>
          <textarea rows="6" required class="w-full px-4 py-3 rounded-xl bg-deep-card border border-deep-border text-white placeholder-gray-600 focus:outline-none focus:border-indigo-500 transition-colors resize-none" placeholder="Tell us what's on your mind..."></textarea>
        </div>
        <button type="submit" class="btn-nebula w-full justify-center">Send Message</button>
      </form>
      <div class="mt-12 pt-8 border-t border-deep-border flex flex-col md:flex-row gap-8 text-sm text-gray-500">
        <div class="flex items-center gap-3"><span class="text-indigo-400">✉️</span> hello@nebularank.com</div>
        <div class="flex items-center gap-3"><span class="text-indigo-400">📍</span> San Francisco, CA</div>
      </div>
    </div>
  </section>
</BaseLayout>
